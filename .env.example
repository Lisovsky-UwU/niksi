# Settings for `docker compose`. Copy to .env and fill in; .env is never committed.

# Database password (any long random string) and the key that signs logins.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_PASSWORD=
SECRET_KEY=

# Where the web app is reachable.
#   Home network over plain HTTP: keep SITE_ADDRESS=:80 and COOKIE_SECURE=false,
#   open http://<computer-ip>:8080 on the phone.
#   Own domain with HTTPS: SITE_ADDRESS=niksi.example.com, COOKIE_SECURE=true,
#   HTTP_PORT=80, HTTPS_PORT=443 (Caddy gets the certificate by itself).
SITE_ADDRESS=:80
COOKIE_SECURE=false
HTTP_PORT=8080
HTTPS_PORT=8443

# Server with its own Nginx (TLS) and PostgreSQL containers (see README.md):
# COMPOSE_FILE=docker-compose.yml:docker-compose.server.yml
# DATABASE_URL=postgresql+psycopg://niksi:<password>@postgres:5432/niksi
# POSTGRES_NETWORK=

# Telegram bot (optional). Uncomment COMPOSE_PROFILES to start the bot container.
# COMPOSE_PROFILES=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Bot API address: change for a mirror/proxy or a local telegram-bot-api server.
TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_SUMMARY_TIME=21:00
TELEGRAM_TIMEZONE=Europe/Moscow

# The two accounts, created once with:
#   docker compose run --rm backend python -m app.scripts.seed_users
SEED_USER1_EMAIL=
SEED_USER1_PASSWORD=
SEED_USER1_NAME=
SEED_USER2_EMAIL=
SEED_USER2_PASSWORD=
SEED_USER2_NAME=
